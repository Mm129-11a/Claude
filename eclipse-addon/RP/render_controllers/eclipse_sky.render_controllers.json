{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.eclipse_sky_dome": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.blend"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "ignore_lighting": true,
   "part_visibility": [
    {
     "*": false
    },
    {
     "root": true
    },
    {
     "dome_1": "v.show && v.stage == 1"
    },
    {
     "dome_2": "v.show && v.stage == 2"
    },
    {
     "dome_3": "v.show && v.stage == 3"
    },
    {
     "dome_4": "v.show && v.stage == 4"
    },
    {
     "dome_5": "v.show && v.stage == 5"
    },
    {
     "dome_6": "v.show && v.stage == 6"
    },
    {
     "dome_7": "v.show && v.stage == 7"
    },
    {
     "dome_8": "v.show && v.stage == 8"
    },
    {
     "dome_9": "v.show && v.stage == 9"
    },
    {
     "dome_10": "v.show && v.stage == 10"
    },
    {
     "dome_11": "v.show && v.stage == 11"
    },
    {
     "dome_12": "v.show && v.stage == 12"
    }
   ]
  },
  "controller.render.eclipse_sky_solid": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.solid"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "ignore_lighting": true,
   "part_visibility": [
    {
     "*": false
    },
    {
     "root": true
    },
    {
     "sun": "v.show && v.sun"
    },
    {
     "moon": true
    },
    {
     "moon_0": "v.show && v.moonk == 0"
    },
    {
     "moon_1": "v.show && v.moonk == 1"
    },
    {
     "moon_2": "v.show && v.moonk == 2"
    },
    {
     "moon_3": "v.show && v.moonk == 3"
    },
    {
     "moon_4": "v.show && v.moonk == 4"
    },
    {
     "moon_5": "v.show && v.moonk == 5"
    },
    {
     "moon_6": "v.show && v.moonk == 6"
    },
    {
     "moon_7": "v.show && v.moonk == 7"
    }
   ]
  },
  "controller.render.eclipse_sky_glow": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.blend"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "ignore_lighting": true,
   "part_visibility": [
    {
     "*": false
    },
    {
     "root": true
    },
    {
     "glow": "v.show && v.glow > 0.01"
    },
    {
     "corona": "v.show && v.corona > 0.01"
    },
    {
     "flash": "v.show && v.flash > 0.01"
    }
   ]
  }
 }
}