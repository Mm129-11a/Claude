{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "supernova:pieza",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/supernova/piezas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.ox * math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3)",
          "variable.oy * math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3)",
          "variable.oz * math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3)"
        ],
        "rotation": "variable.rot * math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.sw",
          "variable.sh"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 453,
          "uv": [
            "variable.pu",
            "variable.pv"
          ],
          "uv_size": [
            "variable.pw",
            "variable.ph"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.5 + 0.5 * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3))",
          "0.45 + 0.55 * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3))",
          "0.4 + 0.6 * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 3))",
          "math.clamp(variable.particle_age / 0.12, 0, 1) * (1 - math.clamp((variable.particle_age - variable.life + 0.15) / 0.15, 0, 1))"
        ]
      }
    }
  }
}
