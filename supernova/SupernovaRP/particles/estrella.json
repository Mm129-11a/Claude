{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "supernova:estrella",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/supernova/estrella_giro"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 3.35
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 0.0
      },
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.s = 5.15 * (1 + math.clamp((variable.particle_age - 2.2) / 1.0, 0, 1) * 0.3) * (1 + math.sin(variable.particle_age * 300) * 0.02);"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.s * 1.0",
          "variable.s"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 2048,
          "texture_height": 2048,
          "uv": [
            "math.mod(math.mod(math.floor(variable.particle_age * 8 + 0), 64), 8) * 256",
            "math.floor(math.mod(math.floor(variable.particle_age * 8 + 0), 64) / 8) * 256"
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp(variable.particle_age / 0.12, 0, 1) * (1 - math.clamp((variable.particle_age - 3.2) / 0.12, 0, 1))"
        ]
      }
    }
  }
}
