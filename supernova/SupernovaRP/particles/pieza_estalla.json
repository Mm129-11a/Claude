{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "supernova:pieza_estalla",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/supernova/piezas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2.2
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.ox * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 2))",
          "variable.oy * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 2))",
          "variable.oz * (1 - math.pow(1 - math.clamp(variable.particle_age / variable.flight, 0, 1), 2))"
        ],
        "rotation": "variable.rot * variable.particle_age"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.sw",
          "variable.sh"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 453,
          "uv": [
            "variable.pu",
            "variable.pv"
          ],
          "uv_size": [
            "variable.pw",
            "variable.ph"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "1 - 0.45 * math.clamp(variable.particle_age / 1.2, 0, 1)",
          "1 - 0.65 * math.clamp(variable.particle_age / 1.2, 0, 1)",
          "1 - math.clamp((variable.particle_age - 1.4) / 0.8, 0, 1)"
        ]
      }
    }
  }
}
