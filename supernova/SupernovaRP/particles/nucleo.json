{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "supernova:nucleo",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/supernova/nucleo"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 0.0
      },
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.s = 5.15 * 1.2 * (0.45 + 0.55 * math.clamp(variable.particle_age / (variable.life - 0.3), 0, 1)) * (1 + 0.08 * math.sin(variable.particle_age * 720));"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.s * 1.0",
          "variable.s"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp(variable.particle_age / 0.4, 0, 1) * (1 - math.clamp((variable.particle_age - variable.life + 0.3) / 0.3, 0, 1))"
        ]
      }
    }
  }
}
