{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "supernova:chispas",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/supernova/brasa"
      }
    },
    "components": {
