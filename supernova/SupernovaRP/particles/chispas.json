      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.25 + 0.3 * variable.particle_random_2) * (1 - (variable.particle_age / variable.particle_lifetime))",
          "(0.25 + 0.3 * variable.particle_random_2) * (1 - (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_1 < 0.5 ? 1 : (variable.particle_random_1 < 0.75 ? 0.75 : 0.88)",
          "variable.particle_random_1 < 0.25 ? 1 : (variable.particle_random_1 < 0.5 ? 0.55 : (variable.particle_random_1 < 0.75 ? 0.6 : 1))",
          "variable.particle_random_1 < 0.25 ? 1 : (variable.particle_random_1 < 0.5 ? 0.75 : 1)",
