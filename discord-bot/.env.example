# Copia este archivo como .env y rellénalo.

# Token del bot (Discord Developer Portal → tu app → Bot → Reset Token). Obligatorio.
DISCORD_TOKEN=

# Clave de la API de Claude (https://console.anthropic.com) para que hable de verdad.
# Si lo dejas vacío, contesta con frases de reserva.
ANTHROPIC_API_KEY=

# Nombre del muñeco y palabras con las que se da por aludido.
BOT_NAME=Netvi
NAME_TRIGGERS=netvi,netvy

# Canales por los que puede pasear (IDs o nombres, separados por comas). Vacío = todos.
WANDER_CHANNELS=
# Canales en los que no debe entrar nunca.
EXCLUDE_CHANNELS=reglas,anuncios

# Cada cuántos minutos cambia de canal (al azar entre mínimo y máximo).
WANDER_MIN_MINUTES=25
WANDER_MAX_MINUTES=70
# Probabilidad (0 a 1) de quedarse haciendo algo en vez de cambiar de canal. 0 = cambia siempre.
STAY_CHANCE=0.25
# Solo entra en canales donde alguien escribió en los últimos N minutos (0 = en cualquiera).
ACTIVE_WINDOW_MINUTES=180

# Horas en las que se va a dormir (formato inicio-fin, 24 h) y zona horaria.
QUIET_HOURS=1-9
TIMEZONE=Europe/Madrid

# Probabilidad de reaccionar con un emoji a mensajes del canal donde está (0 a 1).
REACT_CHANCE=0.06
# Máximo de respuestas con Claude por hora (para controlar el gasto).
MAX_REPLIES_PER_HOUR=120

# Canal de bienvenida (ID). Si lo pones, activa también "Server Members Intent" en el portal.
WELCOME_CHANNEL_ID=
